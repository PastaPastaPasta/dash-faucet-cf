{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dash-faucet",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": [],
  "observability": { "enabled": true },

  // dashtx's ESM entry (dashtx.mjs) evaluates a bare `window`, which is a
  // ReferenceError in workerd. Its CommonJS build guards with
  // `globalThis.window || {}`, so resolve the package to that instead.
  // Mirrored by resolve.alias in vitest.config.ts.
  "alias": {
    "dashtx": "./node_modules/dashtx/dashtx.js"
  },

  // Inherited by every environment.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Treasury"] }
  ],

  "env": {
    "testnet": {
      "assets": { "directory": "./public", "binding": "ASSETS" },
      "routes": [
        { "pattern": "faucet.dashhq.org", "custom_domain": true },
        { "pattern": "faucet.thepasta.org", "custom_domain": true }
      ],
      "triggers": { "crons": ["*/10 * * * *"] },
      "durable_objects": {
        "bindings": [{ "name": "TREASURY", "class_name": "Treasury" }]
      },
      "unsafe": {
        "bindings": [
          {
            "name": "EDGE_LIMIT",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": { "limit": 20, "period": 60 }
          }
        ]
      },
      "vars": {
        "NETWORK": "testnet",
        // 1 tDASH
        "PAYOUT_SATS": "100000000",
        // Hourly per-IP allowance by proof strength. Retunable without a code
        // change; all three stay bounded by DAILY_BUDGET_SATS below.
        "RATE_LIMIT_PER_HOUR": "3",
        "RATE_LIMIT_TURNSTILE_PER_HOUR": "10",
        "RATE_LIMIT_HARD_PER_HOUR": "25",
        // 200 tDASH/day ceiling
        "DAILY_BUDGET_SATS": "20000000000",
        // below this the faucet reports low_balance
        "MIN_BALANCE_SATS": "5000000000",
        "POOL_MIN": "8",
        "POOL_TARGET": "20",
        "POOL_UTXO_SATS": "500000000",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEc7OCY_Mbh19FLS",
        // cap.js proof-of-work challenge for native clients. Must stay inside
        // the Swift SDK's guard: c,s in 1..256, d in 1..6, c * 16^d <= 64M.
        // 100 * 16^4 = 6.55M, the shape the old CAP server served.
        "CAP_C": "100",
        "CAP_S": "32",
        "CAP_D": "4",
        // Escalated shape served at /cap/hard/, for browsers that hit a 429.
        // 50 * 16^6 = 839M — ~30-90s in @cap.js/widget's WASM worker pool, and
        // exactly what the old CAP server served for its hard tier. No native
        // client is offered this, so the SDK's 64M guard does not apply.
        "CAP_HARD_C": "50",
        "CAP_HARD_S": "32",
        "CAP_HARD_D": "6",
        // Pre-created 0.003 DASH identity invitations. Keep disabled until an
        // INVITATION_SECRET and Turnstile secret are installed.
        "INVITATIONS_ENABLED": "0",
        "INVITATION_INVENTORY_TARGET": "3",
        "INVITATION_TTL_SECS": "3600",
        "INVITATION_RATE_WINDOW_SECS": "604800",
        "PLATFORM_EXPLORER_URL": "https://testnet.platform-explorer.pshenmic.dev",
        "DRY_RUN": "0"
      }
    },

    "mainnet": {
      "assets": { "directory": "./public", "binding": "ASSETS" },
      "workers_dev": false,
      "triggers": { "crons": ["*/10 * * * *"] },
      "durable_objects": {
        "bindings": [{ "name": "TREASURY", "class_name": "Treasury" }]
      },
      "unsafe": {
        "bindings": [
          {
            "name": "EDGE_LIMIT",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": { "limit": 10, "period": 60 }
          }
        ]
      },
      "vars": {
        "NETWORK": "mainnet",
        // 0.001 DASH — real money, keep the float thin
        "PAYOUT_SATS": "100000",
        // Hourly per-IP allowance by proof strength. Real money, so the
        // escalated tier is a modest bump rather than testnet's 25.
        "RATE_LIMIT_PER_HOUR": "1",
        "RATE_LIMIT_TURNSTILE_PER_HOUR": "3",
        "RATE_LIMIT_HARD_PER_HOUR": "8",
        // 0.1 DASH/day hard ceiling on total loss
        "DAILY_BUDGET_SATS": "10000000",
        "MIN_BALANCE_SATS": "2000000",
        "POOL_MIN": "8",
        "POOL_TARGET": "20",
        "POOL_UTXO_SATS": "1000000",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEc7OCY_Mbh19FLS",
        // cap.js proof-of-work challenge for native clients. Must stay inside
        // the Swift SDK's guard: c,s in 1..256, d in 1..6, c * 16^d <= 64M.
        // 100 * 16^4 = 6.55M, the shape the old CAP server served.
        "CAP_C": "100",
        "CAP_S": "32",
        "CAP_D": "4",
        // Escalated shape served at /cap/hard/, for browsers that hit a 429.
        // 50 * 16^6 = 839M — ~30-90s in @cap.js/widget's WASM worker pool, and
        // exactly what the old CAP server served for its hard tier. No native
        // client is offered this, so the SDK's 64M guard does not apply.
        "CAP_HARD_C": "50",
        "CAP_HARD_S": "32",
        "CAP_HARD_D": "6",
        // Keep disabled until the parallel mainnet invitation backend is
        // connected behind the testnet faucet's public frontend.
        "INVITATIONS_ENABLED": "0",
        "INVITATION_INVENTORY_TARGET": "3",
        "INVITATION_TTL_SECS": "3600",
        "INVITATION_RATE_WINDOW_SECS": "604800",
        "PLATFORM_EXPLORER_URL": "https://platform-explorer.pshenmic.dev",
        "DRY_RUN": "0"
      }
    }
  }
}
